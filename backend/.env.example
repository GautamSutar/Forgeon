# App
ENVIRONMENT=development
DEBUG=true

# Database (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_agent
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# LLM (LiteLLM / OpenRouter default — free tier, no paid key required)
LLM_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openrouter/openai/gpt-oss-20b:free
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# Embeddings still need a key from a provider that serves an embeddings
# endpoint (OpenRouter is chat-completions only) — RAG/resume-embedding
# features no-op gracefully without one, but won't work until set.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Storage — local disk by default. Set CLOUDINARY_URL to store resumes in
# Cloudinary instead: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Image generation — Hugging Face Inference API.
# Whatever token you use here, it must have the "Make calls to Inference
# Providers" permission enabled at huggingface.co/settings/tokens — this is
# a separate, token-level checkbox, not something granted automatically by
# having a valid token or by accepting a model's license.
# FLUX.1-schnell (default) is Apache-2.0 and ungated — no license step.
# FLUX.1-dev is gated (accept the licence at
# huggingface.co/black-forest-labs/FLUX.1-dev) and non-commercial-licensed.
HUGGINGFACE_API_KEY=
IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
# "auto" routes to whichever provider currently serves the model (fal,
# Replicate, WaveSpeed, hf-inference, ...) — set to a specific provider slug
# only if you need predictable pricing/latency.
IMAGE_PROVIDER=auto
IMAGE_STORAGE_DIR=./storage/images

CLOUDINARY_URL=
RESUME_STORAGE_DIR=./storage/resumes
SCREENSHOT_STORAGE_DIR=./storage/screenshots
MAX_UPLOAD_SIZE_MB=10

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

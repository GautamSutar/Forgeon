# =====================================================================
# Environment / secrets — NEVER commit real .env files, only .env.example
# =====================================================================
.env
.env.*
!.env.example
!*/.env.example
*.env.local
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# Credentials / keys that sometimes end up dropped in a repo by accident
*.pem
*.key
*.crt
*.p12
*credentials*.json
*service-account*.json

# =====================================================================
# Python (backend/)
# =====================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# Alembic-generated local sqlite (only relevant if DATABASE_URL points at
# sqlite locally instead of Postgres/Neon)
backend/*.db
backend/*.sqlite3

# Backend runtime data (uploaded resumes, screenshots) — never committed,
# regardless of which backend subdir it lives under
backend/storage/
storage/resumes/
storage/screenshots/

# =====================================================================
# Node / frontend (frontend/, browser_extension/)
# =====================================================================
node_modules/
dist/
build/
*.tsbuildinfo
.eslintcache
.vite/
coverage/

# =====================================================================
# Docker
# =====================================================================
*.pid

# =====================================================================
# Editor / OS
# =====================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# =====================================================================
# Logs / misc
# =====================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Windows reserved device name — Git Bash turns `-o /dev/null` into a literal
# `nul` file that git cannot index.
nul

# Mirrors backend/.env.example — copy to backend/.env for docker compose (env_file: ./backend/.env)
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/job_agent
DATABASE_ECHO=false

REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

LLM_PROVIDER=anthropic
LLM_DEFAULT_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

RESUME_STORAGE_DIR=./storage/resumes
SCREENSHOT_STORAGE_DIR=./storage/screenshots
MAX_UPLOAD_SIZE_MB=10

RATE_LIMIT_PER_MINUTE=60
